{
  "cli": { "version": ">= 5.9.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://petverse-api.up.railway.app",
        "EXPO_PUBLIC_AI_URL": "https://petverse-ai.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "pm@petverse.app", "ascAppId": "XXXXXXXX", "appleTeamId": "YYYYYYYY" },
      "android": { "serviceAccountKeyPath": "./google-service-account.json", "track": "internal" }
    }
  }
}
